# Data files (download separately, see data/raw/README.md)
data/raw/*.csv
data/raw/*.parquet
data/raw/burstgpt_data/
data/raw/burstgpt/
# But keep the README and gitkeep
!data/raw/README.md
!data/raw/.gitkeep

# Outputs are tracked — they are reviewer-facing deliverables,
# not regenerable build artifacts. Raw data lives in OneDrive and
# cannot be re-pulled without environment setup, so tracked outputs
# bridge the reproducibility gap for clone-and-inspect reviewers.

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/

# OS
.DS_Store
Thumbs.db

archive/Tomorrow.md