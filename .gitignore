# Data files (download separately, see data/raw/README.md)
data/raw/*.csv
data/raw/*.parquet
data/raw/burstgpt_data/

# But keep the README and gitkeep
!data/raw/README.md
!data/raw/.gitkeep

# Generated outputs (regenerated by running notebooks)
outputs/contracts/*.json
outputs/contracts/*.parquet
outputs/figures/*.png
outputs/tables/*.csv

# But keep gitkeeps so the directories survive
!outputs/contracts/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/

# OS
.DS_Store
Thumbs.db